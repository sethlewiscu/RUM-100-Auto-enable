# ── Split.io (Harness) Admin API ───────────────────────────────────────────
# Rotate the token that was exposed in HArness.postman_collection.json.
SPLIT_API_TOKEN=sat.xxxxxxxxxxxxxxxxxxxxxxxx
SPLIT_WS_ID=1f03bc00-01f0-11ec-a057-42851e80ca2c
SPLIT_ENV_ID=1f08ec20-01f0-11ec-a057-42851e80ca2c
SPLIT_SEGMENT_NAME=RUM100Perc_Workspaces
# Comma-separated approver emails for the change request.
SPLIT_APPROVERS=slewis@clickup.com,mswarna@clickup.com

# ── ClickUp ─────────────────────────────────────────────────────────────────
# Personal/API token used to post result comments back on the task.
CLICKUP_API_TOKEN=pk_xxxxxxxx
# ClickUp API base. Defaults to staging (api.clickup-stg.com). For production,
# set this to https://api.clickup.com/api/v2
# CLICKUP_BASE_URL=https://api.clickup-stg.com/api/v2

# ── Inbound auth ────────────────────────────────────────────────────────────
# Shared secret. Set the SAME value as a custom header in the ClickUp Automation
# "Call webhook" action (default header name: X-Auth-Token). Requests without a
# matching header are rejected with 401.
WEBHOOK_AUTH_TOKEN=replace-me
# Optional: override the header name the Automation sends (default X-Auth-Token).
# WEBHOOK_AUTH_HEADER=X-Auth-Token

# Custom field that holds the workspace ID. Match by field id OR name.
WORKSPACE_ID_FIELD=Workspace ID [Perf]

# ── Server ──────────────────────────────────────────────────────────────────
# Replit provides PORT automatically; default to 3000 locally.
PORT=3000
